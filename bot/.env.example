# Получить у @BotFather
BOT_TOKEN=

# URL вашего backend API (после деплоя, напр. https://api.yourdomain.uz)
BACKEND_URL=http://localhost:3001

# URL Mini App (после деплоя фронтенда, напр. https://app.yourdomain.uz)
MINIAPP_URL=https://your-miniapp-url.example.com

# Необязательно — нужен только для голосового ввода ("заработал сто тысяч")
# Бесплатный ключ: aistudio.google.com/app/apikey
# Без него бот просто попросит написать сумму текстом вместо голоса
GEMINI_API_KEY=
